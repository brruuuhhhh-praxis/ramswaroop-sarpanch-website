@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700;800;900&display=swap');

:root{font-family:'Noto Sans Devanagari','DM Sans',sans-serif;color:#132b31;background:#f8f8f3;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;font-weight:400;--navy:#0f172a;--navy-2:#1e293b;--green:#0b7258;--green-bright:#14a078;--mint:#cfeee1;--cream:#f8f8f3;--paper:#fff;--gold:#d5b66b;--text:#183338;--muted:#687a7d;--line:#dfe9e3;--shadow:0 24px 65px rgba(10,44,47,.10)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;min-width:320px;background:var(--cream)}button,input,textarea{font:inherit}button,a{-webkit-tap-highlight-color:transparent}a{color:inherit;text-decoration:none}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #d5b66b;outline-offset:3px}::selection{background:#c9e9dd;color:var(--navy)}.site-shell{overflow:hidden}.top-strip{height:34px;background:#061f24;color:#d5e8df;font-size:11px;letter-spacing:.04em;display:flex;align-items:center;justify-content:center;gap:9px}.top-strip-dot,.caption-dot{width:7px;height:7px;border-radius:50%;background:#80d8ac;box-shadow:0 0 0 4px rgba(128,216,172,.12)}
.site-header{height:78px;padding:0 max(5vw,calc((100vw - 1200px)/2));background:rgba(248,248,243,.92);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);display:flex;align-items:center;justify-content:space-between;gap:22px;border-bottom:1px solid rgba(15,58,60,.08);position:sticky;top:0;z-index:50}.brand{display:inline-flex;align-items:center;gap:11px;flex-shrink:0}.brand-mark{height:45px;width:45px;border-radius:15px;background:linear-gradient(145deg,#0d7158,#092b31);color:#fff;display:grid;place-items:center;font-size:17px;font-weight:900;box-shadow:0 8px 20px rgba(9,70,57,.18);border:1px solid rgba(255,255,255,.24)}.brand-copy{display:grid;gap:3px}.brand-copy strong{font-size:15px;font-weight:800;letter-spacing:-.02em}.brand-copy small{font-size:10px;color:#6e7e7e}.main-nav{display:flex;align-items:center;gap:30px}.main-nav>a{font-size:12px;font-weight:700;color:#42595a;transition:color .2s}.main-nav>a:hover{color:var(--green)}.nav-cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 18px;border:0;border-radius:12px;background:var(--green);color:#fff;font-size:12px;font-weight:700;box-shadow:0 9px 19px rgba(11,114,88,.16);transition:transform .2s,background .2s}.nav-cta:hover{background:#085d48;transform:translateY(-2px)}.mobile-menu-button{display:none;border:1px solid var(--line);background:white;color:var(--navy);width:46px;height:46px;border-radius:12px;align-items:center;justify-content:center}
.hero{position:relative;isolation:isolate;color:#fff;background:radial-gradient(ellipse at 75% 42%,rgba(5,150,105,.32),transparent 39%),linear-gradient(115deg,#0f172a 0%,#17243a 53%,#064e3b 100%);min-height:630px}.hero-pattern,.closing-pattern{position:absolute;inset:0;z-index:-1;opacity:.13;background-image:radial-gradient(rgba(220,240,226,.5) .7px,transparent .7px);background-size:19px 19px;mask-image:linear-gradient(90deg,transparent,black 68%,black)}.hero:before{content:"";position:absolute;z-index:-1;right:-130px;top:-220px;width:570px;height:570px;border:1px solid rgba(205,237,216,.14);border-radius:50%;box-shadow:0 0 0 46px rgba(205,237,216,.025),0 0 0 92px rgba(205,237,216,.018)}.hero-inner{max-width:1200px;min-height:620px;margin:0 auto;padding:76px 32px 65px;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:42px}.hero-copy{max-width:680px;position:relative;z-index:2}.eyebrow{display:flex;align-items:center;gap:10px;color:#b9e9d3;font-size:11px;letter-spacing:.06em;font-weight:700;margin-bottom:23px}.eyebrow-line{width:28px;height:1px;background:var(--gold)}.hero h1{margin:0 0 18px;font-size:clamp(38px,5.2vw,66px);line-height:1.17;letter-spacing:-.045em;font-weight:900}.hero h1 span{color:#9cddbc}.hero-slogan{margin:0 0 19px;padding-left:17px;border-left:2px solid var(--gold);font-size:clamp(18px,2.1vw,25px);line-height:1.7;letter-spacing:-.015em;font-weight:800}.hero-slogan em{font-style:normal;color:#b0e6c7}.hero-description{max-width:535px;color:#c5d8d4;font-size:13px;line-height:2;margin:0 0 27px}.hero-actions{display:flex;flex-wrap:wrap;gap:12px}.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;border:1px solid transparent;border-radius:13px;min-height:48px;padding:0 19px;font-size:12px;font-weight:800;transition:transform .2s,box-shadow .2s,background .2s}.button:hover{transform:translateY(-2px)}.button-large{min-height:54px;padding:0 21px}.button-whatsapp{background:#18a66b;color:white;box-shadow:0 10px 24px rgba(8,30,25,.18)}.button-whatsapp:hover{background:#128b5b;box-shadow:0 13px 28px rgba(8,30,25,.25)}.button-glass{border-color:rgba(255,255,255,.2);background:rgba(255,255,255,.07);color:#fff;backdrop-filter:blur(14px)}.button-glass:hover{background:rgba(255,255,255,.13)}.hero-values{display:flex;flex-wrap:wrap;gap:22px;margin-top:24px;color:#d8e6e1;font-size:11px}.hero-values span{display:flex;gap:7px;align-items:center}.hero-values svg{color:#99dcb9}.hero-scroll{position:absolute;bottom:17px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:9px;color:#b4d4c7;font-size:10px;letter-spacing:.08em}.hero-scroll svg{animation:floatDown 1.8s ease-in-out infinite}@keyframes floatDown{0%,100%{transform:translateY(0)}50%{transform:translateY(4px)}}
.portrait-shell{position:relative;max-width:460px;width:100%;min-height:450px;margin:0 auto;display:grid;place-items:center}.portrait-ring{position:absolute;width:min(94%,390px);aspect-ratio:1;border-radius:50%;border:1px solid rgba(204,233,210,.26);box-shadow:0 0 0 22px rgba(204,233,210,.035),0 0 0 52px rgba(204,233,210,.025)}.portrait-frame{position:relative;width:min(82%,320px);height:400px;overflow:hidden;border:7px solid rgba(223,245,229,.82);outline:1px solid rgba(213,182,107,.85);outline-offset:8px;border-radius:175px 175px 28px 28px;background:linear-gradient(145deg,#e3efdf,#a9d1bd);box-shadow:0 24px 75px rgba(0,0,0,.28);z-index:1}.portrait-frame img{width:100%;height:100%;display:block;object-fit:cover;object-position:center top}.portrait-placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:11px;color:#16463e;padding:20px;background:radial-gradient(circle at 50% 35%,#eff7df 0,#b7d9bd 48%,#83b9a6 100%)}.portrait-initials{width:112px;height:112px;border-radius:50%;display:grid;place-items:center;border:2px solid rgba(12,80,61,.27);font-size:36px;font-weight:900;background:rgba(255,255,255,.3)}.portrait-placeholder>span{font-weight:900;font-size:17px}.portrait-placeholder small{font-size:10px;opacity:.8}.portrait-caption{position:absolute;bottom:28px;left:2px;display:flex;align-items:center;gap:9px;background:rgba(5,35,38,.76);border:1px solid rgba(218,240,228,.2);padding:12px 17px;border-radius:12px;color:#e0eee7;font-size:11px;backdrop-filter:blur(14px);z-index:3}.caption-dot{width:6px;height:6px}.symbol-badge{position:absolute;right:-1px;top:45px;z-index:4;width:150px;border-radius:16px;border:1px solid rgba(255,255,255,.65);background:rgba(250,252,245,.96);padding:12px 12px 10px;text-align:center;color:#183c35;box-shadow:0 13px 40px rgba(0,0,0,.2),0 0 0 5px rgba(205,236,215,.08)}.symbol-kicker{display:flex;align-items:center;justify-content:center;gap:5px;font-size:10px;font-weight:800;color:#527069}.symbol-kicker svg{color:#b28b32}.symbol-art{height:76px;display:grid;place-items:center;margin:7px 0}.symbol-art img{height:100%;max-width:100%;object-fit:contain}.symbol-placeholder{display:flex;flex-direction:column;align-items:center;gap:5px;color:#126249}.symbol-placeholder svg{filter:drop-shadow(0 2px 7px rgba(8,95,63,.22))}.symbol-placeholder span{font-size:10px;font-weight:800}.symbol-foot{font-size:8px;line-height:1.5;color:#8c9a90}
.trust-band{max-width:1120px;margin:-1px auto 0;padding:25px 28px;display:grid;grid-template-columns:repeat(3,1fr);gap:23px;border:1px solid #e4eae2;border-top:0;border-radius:0 0 22px 22px;background:#fff;box-shadow:0 14px 40px rgba(13,52,49,.045);position:relative;z-index:5}.trust-item{display:flex;align-items:center;gap:13px;justify-content:center}.trust-icon{width:43px;height:43px;display:grid;place-items:center;border-radius:13px;color:var(--green);background:#e7f5ec}.trust-item strong,.trust-item small{display:block}.trust-item strong{font-size:12px;font-weight:800}.trust-item small{font-size:10px;margin-top:4px;color:var(--muted)}
.section{max-width:1150px;margin:0 auto;padding:100px 30px}.about-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:74px;align-items:center}.section-side-label{display:flex;align-items:center;gap:10px;color:#7b8c88;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:28px}.section-side-label span{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;border:1px solid #d8e6dd;color:var(--green);font-size:10px;letter-spacing:0}.about-visual{min-height:400px;border-radius:23px;padding:46px 37px;position:relative;overflow:hidden;background:linear-gradient(150deg,#0d5549,#092b31);color:#f4f4e6;display:flex;flex-direction:column;justify-content:center;box-shadow:var(--shadow)}.about-visual:before{content:"";position:absolute;inset:15px;border:1px solid rgba(207,238,225,.22);border-radius:15px}.about-quote-mark{font-family:Georgia,serif;font-size:94px;line-height:.7;color:#d7bd77;margin-bottom:12px}.about-visual p{font-size:clamp(22px,2.7vw,31px);font-weight:800;line-height:1.75;margin:0;position:relative;z-index:1}.about-visual-rule{height:2px;width:64px;background:var(--gold);margin:25px 0 15px}.about-visual>span{font-size:11px;color:#c0ddd0}.about-wheat{position:absolute;right:22px;bottom:12px;color:rgba(204,230,207,.14);transform:rotate(-14deg)}.section-kicker{font-size:11px;color:var(--green);font-weight:900;letter-spacing:.035em;margin-bottom:12px}.about-content h2,.section-heading h2,.issue-copy h2{margin:0 0 22px;font-size:clamp(30px,4vw,46px);line-height:1.33;letter-spacing:-.035em;color:#12363a;font-weight:900}.about-content h2 span,.section-heading h2 span,.issue-copy h2 span{color:var(--green)}.about-content>p:not(.about-highlight){font-size:13px;color:#637577;line-height:2.1;margin:0 0 14px}.about-signoff{display:flex;align-items:center;gap:12px;margin-top:26px}.signoff-line{width:35px;height:2px;background:var(--gold)}.about-signoff strong,.about-signoff small{display:block}.about-signoff strong{font-size:14px}.about-signoff small{font-size:10px;color:var(--muted);margin-top:3px}.about-highlight{margin:24px 0 0;padding:13px 16px;border-left:3px solid var(--green);background:#ebf4ec;color:#245548;border-radius:0 9px 9px 0;font-size:13px;font-weight:800;line-height:1.8}
.manifesto-section{max-width:none;background:#eef3ec;padding:94px max(30px,calc((100vw - 1090px)/2)) 95px}.section-heading{text-align:center;max-width:690px;margin:0 auto 42px}.section-heading .section-kicker{margin-bottom:12px}.section-heading h2{margin-bottom:12px}.section-heading>p{font-size:12px;color:#708080;line-height:2;margin:0}.manifesto-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:17px;max-width:1150px;margin:0 auto}.manifesto-card{min-height:270px;padding:23px 21px 18px;border:1px solid #dde7dd;border-radius:18px;background:rgba(255,255,255,.86);box-shadow:0 8px 25px rgba(12,51,44,.035);display:flex;flex-direction:column;transition:transform .24s,box-shadow .24s,border-color .24s}.manifesto-card:hover{transform:translateY(-7px);box-shadow:0 20px 36px rgba(12,51,44,.1);border-color:#a9d5bd}.card-topline{display:flex;align-items:center;justify-content:space-between;margin-bottom:25px}.card-number{font-size:11px;color:#9caaa1;font-weight:800;letter-spacing:.08em}.manifesto-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#e6f3e9;color:var(--green);transition:background .2s,color .2s}.manifesto-card:hover .manifesto-icon{background:var(--green);color:white}.manifesto-card h3{margin:0 0 12px;font-size:16px;line-height:1.55;color:#14373b}.manifesto-card p{font-size:11px;line-height:2;color:#6b7c7d;margin:0 0 19px}.card-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:12px;border-top:1px solid #edf1ec;color:var(--green);font-size:10px;font-weight:800}.more-priorities{max-width:1150px;margin:22px auto 0;padding:20px 24px;display:flex;align-items:center;gap:16px;border:1px solid #dce8dc;border-radius:16px;background:rgba(255,255,255,.6)}.more-priorities-icon{flex-shrink:0;width:45px;height:45px;display:grid;place-items:center;border-radius:13px;background:#deefe2;color:var(--green)}.more-priorities strong{font-size:12px;color:#153c3c}.more-priorities p{font-size:11px;color:#72807b;line-height:1.85;margin:5px 0 0}
.supporter-section{padding:45px 30px;background:#fff;border-top:1px solid #e5ebe4;border-bottom:1px solid #e5ebe4}.supporter-inner{max-width:1080px;margin:0 auto;display:flex;align-items:center;gap:22px}.supporter-icon{width:61px;height:61px;border-radius:19px;display:grid;place-items:center;background:#e5f4e8;color:var(--green);flex-shrink:0}.supporter-copy{flex:1}.supporter-copy .section-kicker{margin-bottom:5px;display:block}.supporter-copy h2{margin:0 0 4px;font-size:26px;letter-spacing:-.03em;color:#12383b}.supporter-copy h2 span{color:var(--green)}.supporter-copy p{margin:0;color:#728182;font-size:11px;line-height:1.8}.supporter-link{display:inline-flex;align-items:center;gap:9px;min-height:48px;padding:0 18px;border-radius:12px;border:1px solid #d2e3d7;color:var(--green);font-size:11px;font-weight:800;white-space:nowrap;transition:background .2s}.supporter-link:hover{background:#eef7f0}
.issue-section{padding-top:100px;padding-bottom:105px}.issue-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:85px;align-items:start}.issue-copy .section-side-label{margin-bottom:27px}.issue-copy h2{font-size:clamp(36px,4vw,49px);margin-bottom:16px}.issue-copy>p{font-size:13px;color:#6e7f80;line-height:2.05;margin:0 0 23px;max-width:430px}.issue-list{display:grid;gap:12px;margin-bottom:24px}.issue-list-item{display:flex;align-items:center;gap:11px;font-size:11px;color:#415a5b}.issue-list-item>span{width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:#e5f2e8;color:var(--green)}.privacy-note{display:flex;align-items:flex-start;gap:10px;padding:14px;border:1px solid #e0e9e0;background:#f0f5ed;border-radius:12px;color:#657b71;font-size:10px;line-height:1.8}.privacy-note svg{color:var(--green);flex-shrink:0}.issue-form{padding:30px;border:1px solid #e2eae2;border-radius:21px;background:#fff;box-shadow:var(--shadow)}.form-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}.form-eyebrow{display:block;color:var(--green);font-size:10px;font-weight:900;margin-bottom:6px}.form-header h3{font-size:24px;color:#14363a;margin:0;font-weight:900}.form-icon{width:48px;height:48px;border-radius:15px;background:#e6f4e9;display:grid;place-items:center;color:var(--green)}.issue-form label{display:block;margin:17px 0 8px;color:#365254;font-size:11px;font-weight:800}.issue-form label span{color:#c25d4e}.issue-form input,.issue-form textarea{display:block;width:100%;border:1px solid #dce6e0;border-radius:11px;background:#fbfcf9;min-height:48px;padding:13px 14px;color:#17383b;font-size:12px;outline:none;transition:border .2s,box-shadow .2s}.issue-form input::placeholder,.issue-form textarea::placeholder{color:#9aa9a2}.issue-form input:focus,.issue-form textarea:focus{border-color:#61ad8b;box-shadow:0 0 0 3px rgba(17,127,87,.09)}.issue-form textarea{resize:vertical;min-height:118px;line-height:1.8}.form-counter{text-align:right;font-size:9px;color:#91a09b;margin:8px 0 15px}.button-submit{width:100%;min-height:52px}.form-status{margin:13px 0 0;padding:11px 12px;border-radius:9px;background:#e8f6ed;color:#17664a;font-size:11px;line-height:1.8}.form-status-error{background:#fff1eb;color:#9a3e2b}.form-disclaimer{display:block;text-align:center;color:#91a09b;font-size:9px;line-height:1.7;margin-top:13px}
.closing-cta{position:relative;isolation:isolate;overflow:hidden;text-align:center;padding:76px 25px;background:radial-gradient(ellipse at 50% 110%,rgba(5,150,105,.34),transparent 60%),linear-gradient(115deg,#0f172a,#064e3b);color:#fff}.closing-content{max-width:720px;margin:0 auto}.closing-content .section-kicker{color:#a2dfc0}.closing-content h2{font-size:clamp(30px,4.8vw,47px);line-height:1.45;margin:0 0 12px;letter-spacing:-.035em}.closing-content h2 span{color:#a5e2be}.closing-content p{font-size:12px;color:#c4dad1;line-height:1.9;margin:0 0 25px}.button-light{background:#f7f8f1;color:#12463a;box-shadow:0 10px 25px rgba(0,0,0,.15)}.button-light:hover{background:#e1f0e5}.site-footer{padding:36px max(30px,calc((100vw - 1120px)/2)) 18px;background:#061f24;color:#d0e0d9}.footer-main{display:flex;align-items:center;gap:26px;padding-bottom:28px;border-bottom:1px solid rgba(220,239,229,.13)}.brand-footer .brand-mark{background:#154f43;border-color:rgba(255,255,255,.15)}.brand-footer .brand-copy strong{color:#fff}.brand-footer .brand-copy small{color:#9eb5ad}.footer-main>p{max-width:390px;margin:0;color:#9db4ac;font-size:10px;line-height:1.9;flex:1}.footer-top{display:inline-flex;align-items:center;gap:8px;color:#cde5d8;font-size:10px;font-weight:800}.footer-top svg{transform:rotate(180deg)}.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:15px;padding-top:18px;color:#7f9b91;font-size:9px;flex-wrap:wrap}.footer-bottom span{display:inline-flex;align-items:center;gap:6px}.footer-note{max-width:360px;line-height:1.7}.floating-whatsapp{position:fixed;right:22px;bottom:22px;z-index:80;height:56px;min-width:56px;padding:0 17px;border:0;border-radius:999px;display:flex;align-items:center;gap:9px;background:#18a66b;color:#fff;font-size:11px;font-weight:900;box-shadow:0 10px 28px rgba(4,55,35,.25);animation:whatsPulse 3s ease-in-out infinite;transition:transform .2s}.floating-whatsapp:hover{transform:translateY(-3px);background:#10895a}@keyframes whatsPulse{0%,100%{box-shadow:0 10px 28px rgba(4,55,35,.25),0 0 0 0 rgba(24,166,107,.25)}50%{box-shadow:0 10px 28px rgba(4,55,35,.25),0 0 0 8px rgba(24,166,107,0)}}
@media(min-width:1400px){.hero-inner{padding-top:85px;padding-bottom:75px}.hero{min-height:670px}.portrait-shell{transform:scale(1.04)}}
@media(max-width:1000px){.main-nav{gap:18px}.hero-inner{gap:20px;padding-left:35px;padding-right:35px}.portrait-shell{transform:scale(.94)}.about-grid{gap:45px}.manifesto-grid{grid-template-columns:repeat(2,1fr)}.manifesto-card{min-height:245px}.issue-grid{gap:45px}}
@media(max-width:760px){.top-strip{font-size:9px;height:31px}.site-header{height:69px;padding:0 19px}.brand-mark{height:41px;width:41px}.brand-copy strong{font-size:13px}.mobile-menu-button{display:flex}.main-nav{display:none;position:absolute;left:12px;right:12px;top:62px;background:rgba(255,255,250,.98);border:1px solid #e1e9e1;border-radius:17px;box-shadow:0 16px 35px rgba(6,34,31,.16);padding:14px;align-items:stretch;gap:2px;flex-direction:column}.main-nav.nav-open{display:flex}.main-nav>a{padding:14px 12px;border-radius:9px;font-size:13px}.main-nav>a:hover{background:#edf5ee}.nav-cta{margin-top:8px;width:100%;min-height:49px}.hero-inner{grid-template-columns:1fr;padding:52px 22px 54px;gap:24px;min-height:unset}.hero-copy{max-width:none}.eyebrow{font-size:10px;margin-bottom:20px}.hero h1{font-size:clamp(37px,10vw,58px)}.hero-slogan{font-size:clamp(17px,4.6vw,22px);line-height:1.75}.hero-description{font-size:12px}.hero-actions{display:grid;grid-template-columns:1fr}.hero-actions .button{width:100%}.hero-values{gap:13px;font-size:10px}.portrait-shell{min-height:380px;transform:none;max-width:390px;margin:5px auto 0}.portrait-ring{width:290px}.portrait-frame{width:250px;height:315px}.symbol-badge{right:-1px;top:20px;transform:scale(.88);transform-origin:top right}.portrait-caption{bottom:20px;left:0}.hero-scroll{display:none}.trust-band{margin:0 13px;padding:17px 12px;grid-template-columns:1fr;gap:14px;border:1px solid #e4eae2;border-radius:17px}.trust-item{justify-content:flex-start}.trust-item strong{font-size:12px}.section{padding:70px 21px}.about-grid{grid-template-columns:1fr;gap:33px}.about-visual{min-height:330px;padding:35px 29px}.about-visual p{font-size:26px}.about-content h2,.section-heading h2,.issue-copy h2{font-size:34px}.about-content>p:not(.about-highlight){font-size:12px}.manifesto-section{padding:70px 18px}.section-heading{margin-bottom:29px}.section-heading>p{font-size:11px}.manifesto-grid{grid-template-columns:1fr;gap:12px}.manifesto-card{min-height:unset;padding:21px}.card-topline{margin-bottom:16px}.manifesto-card h3{font-size:16px}.manifesto-card p{font-size:11px}.card-foot{margin-top:3px}.more-priorities{align-items:flex-start;padding:17px;gap:12px}.more-priorities p{line-height:1.9}.supporter-section{padding:28px 21px}.supporter-inner{display:grid;grid-template-columns:54px 1fr;gap:13px}.supporter-icon{width:54px;height:54px;border-radius:15px}.supporter-copy h2{font-size:22px}.supporter-copy p{font-size:10px}.supporter-link{grid-column:1/-1;justify-content:center}.issue-section{padding-top:70px;padding-bottom:75px}.issue-grid{grid-template-columns:1fr;gap:32px}.issue-copy .section-side-label{margin-bottom:23px}.issue-copy>p{font-size:12px}.issue-form{padding:22px 18px;border-radius:17px}.form-header h3{font-size:22px}.closing-cta{padding:64px 22px}.closing-content h2{font-size:31px}.closing-content p{font-size:11px}.site-footer{padding:30px 22px 16px}.footer-main{display:grid;grid-template-columns:1fr auto;gap:15px}.footer-main>p{grid-column:1/-1;grid-row:2}.footer-top{grid-column:2;grid-row:1}.footer-bottom{align-items:flex-start;flex-direction:column;gap:10px}.footer-note{max-width:none}.floating-whatsapp{right:13px;bottom:13px;width:54px;height:54px;padding:0;justify-content:center}.floating-whatsapp span{display:none}}
@media(max-width:380px){.hero-inner{padding-left:17px;padding-right:17px}.hero h1{font-size:36px}.hero-values{gap:10px}.hero-values span{gap:4px}.symbol-badge{right:-9px;transform:scale(.78)}.portrait-frame{width:230px;height:300px}.floating-whatsapp{right:10px;bottom:10px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}

.developer-credit{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:5px;margin-top:17px;padding-top:17px;border-top:1px solid rgba(220,239,229,.13);color:#b7ccc3;font-size:11px;letter-spacing:.02em;text-align:center}.developer-credit strong{color:#f2d28c;font-weight:800}.developer-credit [role="img"]{line-height:1}


/* Candidate photo and WhatsApp alignment fix */
.brand-mark.brand-photo {
  padding: 0;
  overflow: hidden;
  background: #fff;
}
.brand-mark.brand-photo img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 20%;
  border-radius: inherit;
}
.floating-whatsapp {
  display: inline-flex !important;
  flex-direction: row !important;
  direction: ltr !important;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.floating-whatsapp > svg {
  order: 0 !important;
  position: static !important;
  left: auto !important;
  right: auto !important;
  margin: 0 !important;
}
.floating-whatsapp > span {
  order: 1 !important;
}


/* Profile photo: larger icon and better face framing */
.site-header .brand-mark.brand-photo {
  width: 58px;
  height: 58px;
  min-width: 58px;
  border-radius: 17px;
  overflow: hidden;
}
.site-header .brand-mark.brand-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 12%;
  transform: scale(1.12);
}
.site-header .brand {
  gap: 13px;
}
@media (max-width: 600px) {
  .site-header .brand-mark.brand-photo {
    width: 64px;
    height: 64px;
    min-width: 64px;
    border-radius: 18px;
  }
  .site-header .brand-mark.brand-photo img {
    object-position: center 12%;
    transform: scale(1.12);
  }
}


/* BPraxis Advanced Sections v1 */
.advanced-section {
  max-width: 1200px;
  margin-inline: auto;
  padding: 72px 28px;
}
.advanced-heading {
  max-width: 700px;
  margin: 0 auto 34px;
  text-align: center;
}
.advanced-kicker {
  display: inline-block;
  margin-bottom: 10px;
  color: #0b7258;
  font-size: 12px;
  font-weight: 800;
}
.advanced-heading h2,
.advanced-share-copy h2 {
  margin: 0 0 12px;
  color: #12363a;
  font-size: clamp(28px, 4vw, 43px);
  line-height: 1.35;
  font-weight: 900;
}
.advanced-heading h2 span {
  color: #0b8b68;
}
.advanced-heading p,
.advanced-share-copy p {
  margin: 0;
  color: #687a7d;
  font-size: 14px;
  line-height: 1.9;
}
.advanced-manifesto-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}
.advanced-manifesto-card {
  display: flex;
  min-width: 0;
  flex-direction: column;
  padding: 24px 21px;
  border: 1px solid #dfe9e3;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 24px rgba(10, 44, 47, .05);
  transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}
.advanced-manifesto-card:hover {
  transform: translateY(-6px);
  border-color: #92cdb2;
  box-shadow: 0 20px 42px rgba(10, 65, 50, .13);
}
.advanced-card-top,
.advanced-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.advanced-card-number {
  color: #82948a;
  font-size: 12px;
  font-weight: 800;
}
.advanced-icon-wrap {
  display: grid;
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  place-items: center;
  border-radius: 16px;
  background: #e8f5ed;
  color: #0b7258;
  transition: background .22s ease, color .22s ease, transform .22s ease;
}
.advanced-manifesto-card:hover .advanced-icon-wrap {
  transform: rotate(-5deg);
  background: #0b7258;
  color: #fff;
}
.advanced-manifesto-card h3 {
  margin: 22px 0 10px;
  color: #14373b;
  font-size: 19px;
  font-weight: 900;
}
.advanced-manifesto-card > p {
  flex: 1;
  margin: 0 0 22px;
  color: #687a7d;
  font-size: 13px;
  line-height: 1.95;
}
.advanced-card-footer {
  padding-top: 14px;
  border-top: 1px solid #edf1ec;
  color: #0b7258;
  font-size: 11px;
  font-weight: 800;
}
.advanced-testimonials {
  max-width: none;
  background: #f0f5ef;
}
.advanced-testimonials > .advanced-heading,
.advanced-testimonial-grid,
.advanced-testimonial-note {
  max-width: 1120px;
  margin-right: auto;
  margin-left: auto;
}
.advanced-testimonial-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}
.advanced-testimonial-card {
  display: flex;
  min-width: 0;
  flex-direction: column;
  padding: 25px;
  border: 1px solid #dfe9e3;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 10px 30px rgba(10, 44, 47, .05);
}
.advanced-quote-icon {
  margin-bottom: 14px;
  color: #0b8b68;
}
.advanced-testimonial-card blockquote {
  flex: 1;
  margin: 0 0 24px;
  color: #254448;
  font-size: 15px;
  font-weight: 600;
  line-height: 2;
}
.advanced-testimonial-label {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-top: 15px;
  border-top: 1px solid #edf1ec;
  color: #687a7d;
  font-size: 11px;
  line-height: 1.7;
}
.advanced-testimonial-label svg {
  flex-shrink: 0;
  color: #0b7258;
}
.advanced-testimonial-note {
  margin-top: 22px;
  color: #687a7d;
  font-size: 11px;
  line-height: 1.8;
  text-align: center;
}
.advanced-oath-section {
  padding: 72px 24px;
  background:
    radial-gradient(ellipse at 80% 10%, rgba(20, 160, 120, .22), transparent 45%),
    linear-gradient(120deg, #0f172a, #064e3b);
}
.advanced-oath-card {
  max-width: 850px;
  margin: 0 auto;
  padding: clamp(26px, 5vw, 48px);
  border: 1px solid rgba(207, 238, 225, .24);
  border-radius: 26px;
  background: rgba(255, 255, 255, .06);
  box-shadow: 0 25px 70px rgba(0, 0, 0, .18);
  color: #fff;
}
.advanced-oath-icon {
  display: grid;
  width: 58px;
  height: 58px;
  margin-bottom: 20px;
  place-items: center;
  border-radius: 17px;
  background: rgba(156, 221, 188, .13);
  color: #9cddbc;
}
.advanced-oath-kicker {
  color: #9cddbc;
  font-size: 12px;
  font-weight: 800;
}
.advanced-oath-card h2 {
  margin: 10px 0 18px;
  font-size: clamp(28px, 4vw, 42px);
  line-height: 1.4;
  font-weight: 900;
}
.advanced-oath-lead {
  margin: 0;
  color: #e4f3eb;
  font-size: clamp(17px, 2.5vw, 22px);
  font-weight: 700;
  line-height: 1.9;
}
.advanced-oath-divider {
  width: 64px;
  height: 3px;
  margin: 24px 0;
  background: #d5b66b;
}
.advanced-oath-text {
  margin: 0;
  color: #c5d8d4;
  font-size: 14px;
  line-height: 2.1;
}
.advanced-oath-signature {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 9px;
  margin-top: 25px;
  color: #a7e3c1;
  font-size: 12px;
  font-weight: 800;
}
.advanced-share-section {
  padding: 52px 24px;
  background: #fff;
  border-block: 1px solid #e2eae2;
}
.advanced-share-inner {
  display: flex;
  max-width: 1120px;
  margin: 0 auto;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}
.advanced-share-copy {
  max-width: 580px;
}
.advanced-share-button {
  display: inline-flex;
  min-height: 56px;
  align-items: center;
  justify-content: center;
  gap: 11px;
  padding: 13px 21px;
  border: 1px solid transparent;
  border-radius: 14px;
  background: #0b8b68;
  color: #fff;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.7;
  text-align: center;
  text-decoration: none;
  box-shadow: 0 8px 20px rgba(11, 114, 88, .15);
  transition: background .2s ease, transform .2s ease;
}
.advanced-share-button:hover {
  transform: translateY(-2px);
  background: #08694f;
}
.advanced-share-button:focus-visible {
  outline: 3px solid #d5b66b;
  outline-offset: 3px;
}
@media (max-width: 900px) {
  .advanced-manifesto-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .advanced-testimonial-grid {
    grid-template-columns: 1fr;
  }
  .advanced-testimonial-card {
    max-width: 650px;
    width: 100%;
    margin-inline: auto;
  }
  .advanced-share-inner {
    align-items: stretch;
    flex-direction: column;
  }
  .advanced-share-button {
    width: 100%;
  }
}
@media (max-width: 520px) {
  .advanced-section {
    padding: 54px 17px;
  }
  .advanced-manifesto-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .advanced-manifesto-card {
    padding: 21px;
  }
  .advanced-oath-section {
    padding: 46px 16px;
  }
  .advanced-share-section {
    padding: 40px 17px;
  }
  .advanced-share-button {
    padding: 13px 14px;
    font-size: 12px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .advanced-manifesto-card,
  .advanced-icon-wrap,
  .advanced-share-button {
    transition: none;
  }
  .advanced-manifesto-card:hover,
  .advanced-manifesto-card:hover .advanced-icon-wrap,
  .advanced-share-button:hover {
    transform: none;
  }
}

/* ===== Clean Black & White Theme ===== */
:root {
  --navy: #111111;
  --navy-2: #222222;
  --green: #111111;
  --green-bright: #333333;
  --mint: #eeeeee;
  --cream: #ffffff;
  --paper: #ffffff;
  --gold: #777777;
  --text: #171717;
  --muted: #666666;
  --line: #e5e5e5;
  --shadow: 0 12px 35px rgba(0, 0, 0, 0.06);
}

body,
.site-shell {
  background: #ffffff;
  color: #111111;
}

.top-strip {
  background: #111111;
  color: #ffffff;
}

.top-strip-dot,
.caption-dot {
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(255,255,255,.12);
}

.site-header {
  background: rgba(255,255,255,.97);
  border-bottom-color: #e5e5e5;
}

.brand-mark {
  background: #111111;
  color: #ffffff;
  box-shadow: none;
}

.main-nav > a {
  color: #333333;
}

.main-nav > a:hover {
  color: #000000;
}

.nav-cta,
.button-whatsapp,
.campaign-share-button,
.advanced-share-button {
  background: #111111;
  color: #ffffff;
  box-shadow: none;
}

.nav-cta:hover,
.button-whatsapp:hover,
.campaign-share-button:hover,
.advanced-share-button:hover {
  background: #333333;
}

.hero {
  background: #ffffff;
  color: #111111;
}

.hero-pattern {
  opacity: .035;
}

.hero:before {
  border-color: rgba(0,0,0,.08);
  box-shadow: 0 0 0 46px rgba(0,0,0,.02),
              0 0 0 92px rgba(0,0,0,.015);
}

.eyebrow,
.hero-values {
  color: #555555;
}

.eyebrow-line {
  background: #777777;
}

.hero h1,
.about-content h2,
.section-heading h2,
.issue-copy h2,
.supporter-copy h2 {
  color: #111111;
}

.hero h1 span,
.about-content h2 span,
.section-heading h2 span,
.supporter-copy h2 span,
.advanced-heading h2 span {
  color: #555555;
}

.hero-slogan {
  border-left-color: #111111;
}

.hero-slogan em {
  color: #444444;
}

.hero-description {
  color: #555555;
}

.button-glass {
  border-color: #dddddd;
  background: #ffffff;
  color: #111111;
  backdrop-filter: none;
}

.button-glass:hover {
  background: #f5f5f5;
}

.hero-values svg,
.trust-icon,
.section-side-label,
.section-kicker,
.advanced-kicker,
.advanced-icon-wrap,
.advanced-card-footer {
  color: #222222;
}

.portrait-ring {
  border-color: rgba(0,0,0,.14);
  box-shadow: 0 0 0 22px rgba(0,0,0,.025),
              0 0 0 52px rgba(0,0,0,.015);
}

.portrait-frame {
  border-color: #ffffff;
  outline-color: #999999;
}

.portrait-caption {
  background: rgba(17,17,17,.9);
  border-color: rgba(255,255,255,.2);
}

.trust-band,
.advanced-manifesto-card,
.testimonial-card,
.issue-form {
  background: #ffffff;
  border-color: #e5e5e5;
  box-shadow: 0 8px 25px rgba(0,0,0,.04);
}

.trust-icon,
.advanced-icon-wrap,
.manifesto-icon,
.form-icon,
.testimonial-avatar {
  background: #f0f0f0;
  color: #111111;
}

.manifesto-card:hover .manifesto-icon,
.advanced-manifesto-card:hover .advanced-icon-wrap {
  background: #111111;
  color: #ffffff;
}

.about-visual {
  background: #111111;
  color: #ffffff;
}

.about-visual-rule,
.signoff-line {
  background: #777777;
}

.about-highlight,
.privacy-note,
.form-status {
  background: #f5f5f5;
  border-color: #e5e5e5;
  color: #333333;
}

.manifesto-section,
.testimonials-section,
.advanced-testimonials {
  background: #f7f7f7;
}

.manifesto-card,
.advanced-manifesto-card,
.testimonial-card,
.advanced-testimonial-card {
  border-color: #e5e5e5;
  background: #ffffff;
}

.manifesto-card:hover,
.advanced-manifesto-card:hover {
  border-color: #999999;
  box-shadow: 0 18px 35px rgba(0,0,0,.09);
}

.more-priorities {
  background: #ffffff;
  border-color: #e5e5e5;
}

.more-priorities-icon {
  background: #f0f0f0;
  color: #111111;
}

.supporter-section,
.issue-section {
  background: #ffffff;
}

.supporter-link {
  border-color: #dddddd;
  color: #111111;
}

.supporter-link:hover {
  background: #f5f5f5;
}

.advanced-oath-section,
.closing-cta {
  background: #111111;
  color: #ffffff;
}

.advanced-oath-card {
  background: #171717;
  border-color: #444444;
}

.advanced-oath-icon {
  background: #292929;
  color: #ffffff;
}

.advanced-oath-kicker,
.advanced-oath-signature,
.closing-content .section-kicker {
  color: #eeeeee;
}

.advanced-oath-lead,
.advanced-oath-text {
  color: #eeeeee;
}

.advanced-oath-divider {
  background: #888888;
}

.campaign-share-section,
.advanced-share-section {
  background: #ffffff;
  border-color: #e5e5e5;
}

.campaign-share-secondary {
  background: #ffffff;
  color: #111111;
  border-color: #dddddd;
}

.floating-whatsapp {
  background: #111111 !important;
  color: #ffffff !important;
  box-shadow: 0 8px 24px rgba(0,0,0,.18) !important;
}

.site-footer,
footer {
  background: #ffffff;
  color: #111111;
  border-top: 1px solid #e5e5e5;
}

::selection {
  background: #222222;
  color: #ffffff;
}




/* OFFICIAL CAMPAIGN POSTER */
.official-poster-section {
  padding: clamp(36px, 7vw, 76px) 18px;
  background: #f3f3f3;
  color: #111;
}
.official-poster-inner {
  width: min(100%, 1050px);
  margin: 0 auto;
}
.official-poster-kicker {
  margin: 0 0 8px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
}
.official-poster-inner h2 {
  margin: 0 0 12px;
  color: #111;
  font-size: clamp(25px, 4vw, 38px);
}
.official-poster-description,
.official-poster-note {
  color: #444;
  line-height: 1.7;
}
.official-poster-preview {
  margin-top: 24px;
  overflow: hidden;
  border: 2px solid #111;
  background: #fff;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
}
.official-poster-preview canvas {
  display: block;
  width: 100%;
  height: auto;
}
.official-poster-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 20px;
}
.official-poster-button {
  min-height: 48px;
  border: 2px solid #111;
  border-radius: 6px;
  padding: 12px 20px;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.15s ease, background 0.15s ease;
}
.official-poster-button:hover {
  transform: translateY(-2px);
}
.official-poster-download {
  background: #111;
  color: #fff;
}
.official-poster-share {
  background: #fff;
  color: #111;
}
.official-poster-note {
  margin-top: 14px;
  font-size: 13px;
}
@media (max-width: 520px) {
  .official-poster-actions {
    flex-direction: column;
  }
  .official-poster-button {
    width: 100%;
  }
}


/* UNIQUE RAJASTHANI ROYAL CAMPAIGN POSTER */
.official-poster-section {
  padding: clamp(34px, 6vw, 72px) 16px;
  background: #f8f0df;
  color: #28151f;
}
.official-poster-inner {
  width: min(100%, 1080px);
  margin: 0 auto;
}
.official-poster-kicker {
  color: #651d35;
  letter-spacing: 2px;
  font-size: 12px;
  font-weight: 800;
}
.official-poster-inner h2 {
  color: #28151f;
  font-size: clamp(23px, 4vw, 36px);
  line-height: 1.35;
  margin: 8px 0 12px;
}
.official-poster-description,
.official-poster-note {
  color: #54444a;
  line-height: 1.7;
}
.official-poster-preview {
  margin-top: 22px;
  overflow: hidden;
  border: 3px solid #651d35;
  background: #f8f0df;
  box-shadow: 0 14px 36px rgba(40, 21, 31, 0.20);
}
.official-poster-preview canvas {
  display: block;
  width: 100%;
  height: auto;
}
.official-poster-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 20px;
}
.official-poster-button {
  min-height: 48px;
  padding: 12px 20px;
  border: 2px solid #651d35;
  border-radius: 5px;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}
.official-poster-download {
  background: #651d35;
  color: #fff8e9;
}
.official-poster-share {
  background: #f8f0df;
  color: #651d35;
}
.official-poster-button:hover {
  filter: brightness(0.94);
}
.official-poster-note {
  font-size: 13px;
  margin-top: 12px;
}
@media (max-width: 520px) {
  .official-poster-actions {
    flex-direction: column;
  }
  .official-poster-button {
    width: 100%;
  }
}
