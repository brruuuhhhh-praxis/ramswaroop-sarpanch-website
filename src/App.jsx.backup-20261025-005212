function App() {
  const [page, setPage] = useState("home");
  const [menuOpen, setMenuOpen] = useState(false);
  const [form, setForm] = useState(initialForm);
  const [status, setStatus] = useState("");
  const [busy, setBusy] = useState(false);
  const [messages, setMessages] = useState([]);
  const [messagesLoading, setMessagesLoading] = useState(false);
  const [messagesError, setMessagesError] = useState("");
  const [shareStatus, setShareStatus] = useState("");
  const [selectedPhoto, setSelectedPhoto] = useState(null);
  const [suggestionPhoto, setSuggestionPhoto] = useState(null);
  const [suggestionPhotoPreview, setSuggestionPhotoPreview] = useState("");

  function navigate(id) {
    setPage(id);
    setMenuOpen(false);
    setStatus("");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  async function loadMessages() {
    if (!supabaseReady) {
      setMessagesError("सार्वजनिक संदेश दिखाने के लिए Supabase configuration आवश्यक है।");
      return;
    }
    setMessagesLoading(true);
    setMessagesError("");
    try {
      const client = await getSupabase();
      if (!client) {
        setMessagesError("Supabase से कनेक्शन नहीं बन पाया। configuration जाँचें।");
        return;
      }
      const { data, error } = await client.from("public_messages")
        .select("id, display_name, category, message, photo_url, created_at")
        .eq("status", "approved").order("created_at", { ascending: false }).limit(12);
      if (error) {
        console.error("Public messages query failed", error);
        setMessagesError("संदेश लोड नहीं हो सके। Supabase table और read policy जाँचें, फिर दोबारा कोशिश करें।");
        return;
      }
      setMessages(data || []);
    } catch (error) {
      console.error("Public messages could not be loaded", error);
      setMessagesError("कनेक्शन में समस्या है। इंटरनेट जाँचकर फिर कोशिश करें।");
    } finally {
      setMessagesLoading(false);
    }
  }

  useEffect(() => { if (page === "messages") loadMessages(); }, [page]);

  // Release local object URLs when a new preview is selected or the form is left.
  useEffect(() => {
    if (!suggestionPhotoPreview) return undefined;
    return () => URL.revokeObjectURL(suggestionPhotoPreview);
  }, [suggestionPhotoPreview]);

  async function shareSite() {
    const shareData = { title: "श्री रामस्वरूप बरोड़ | कीकर वाली जोहड़ी", text: "सार्वजनिक जानकारी और जन-संवाद", url: window.location.href };
    try {
      if (navigator.share) await navigator.share(shareData);
      else if (navigator.clipboard) { await navigator.clipboard.writeText(window.location.href); setShareStatus("वेबसाइट लिंक कॉपी हो गया।"); }
      else setShareStatus("इस ब्राउज़र में शेयर सुविधा उपलब्ध नहीं है।");
    } catch (e) { if (e?.name !== "AbortError") setShareStatus("लिंक शेयर नहीं हो पाया।"); }
  }

  async function submitMessage(e) {
    e.preventDefault();
    setStatus("");
    const message = form.message.trim();
    const name = form.display_name.trim();
    if (message.length < 4 || message.length > 500) { setStatus("संदेश 4 से 500 अक्षरों के बीच रखें।"); return; }
    if (name.length > 60) { setStatus("नाम 60 अक्षरों से छोटा रखें।"); return; }
    if (!supabaseReady) { setStatus("ऑनलाइन फॉर्म चालू करने के लिए Supabase सेटअप बाकी है।"); return; }
    const allowedImageTypes = ["image/jpeg", "image/png", "image/webp"];
    if (suggestionPhoto && (!allowedImageTypes.includes(suggestionPhoto.type) || suggestionPhoto.size > 2 * 1024 * 1024)) {
      setStatus("कृपया 2 MB से छोटी JPG, PNG या WebP तस्वीर चुनें।"); return;
    }
    setBusy(true);
    try {
      const client = await getSupabase();
      if (!client) { setStatus("ऑनलाइन फॉर्म चालू करने के लिए Supabase सेटअप बाकी है।"); return; }
      let photoUrl = null;
      if (suggestionPhoto) {
        const ext = (suggestionPhoto.name.split(".").pop() || "jpg").toLowerCase().replace(/[^a-z0-9]/g, "");
        const path = `${Date.now()}-${Math.random().toString(36).slice(2, 10)}.${ext}`;
        const { error: uploadError } = await client.storage.from("suggestion-photos").upload(path, suggestionPhoto, { upsert: false, contentType: suggestionPhoto.type });
        if (uploadError) { setStatus("तस्वीर अपलोड नहीं हुई। Supabase में suggestion-photos storage bucket और policies सेट करें।"); return; }
        const { data: urlData } = client.storage.from("suggestion-photos").getPublicUrl(path);
        photoUrl = urlData?.publicUrl || null;
      }
      const { error } = await client.from("public_messages").insert({
        display_name: name || null, category: form.category, message, photo_url: photoUrl, status: "pending"
      });
      if (error) { setStatus("संदेश जमा नहीं हो पाया। कृपया बाद में कोशिश करें।"); return; }
      setForm(initialForm);
      setSuggestionPhoto(null); setSuggestionPhotoPreview("");
      setStatus("धन्यवाद! संदेश समीक्षा के लिए जमा हो गया है। स्वीकृति के बाद ही सार्वजनिक होगा।");
    } catch (error) {
      console.error("Message submission failed", error);
      setStatus("कनेक्शन में समस्या है। कृपया इंटरनेट जाँचकर फिर कोशिश करें।");
    } finally {
      setBusy(false);
    }
  }

