    {[{icon:Droplets,title:"पेयजल और जल-निकासी",desc:"पानी की उपलब्धता, नियमित आपूर्ति और जल निकासी से जुड़ी जरूरतों की पहचान।"},{icon:Route,title:"सड़क और रास्ते",desc:"खराब रास्तों की पहचान और संबंधित विभागों तक मरम्मत संबंधी विषय पहुँचाना।"},{icon:Leaf,title:"सफाई और कचरा प्रबंधन",desc:"सार्वजनिक स्थानों की स्वच्छता और कचरा निपटान व्यवस्था पर ध्यान।"},{icon:Lightbulb,title:"स्ट्रीट लाइट",desc:"अंधेरे वाले सार्वजनिक स्थानों की पहचान और रोशनी की जरूरतों पर प्रस्ताव।"},{icon:BookOpen,title:"योजनाओं की जानकारी",desc:"सरकारी योजनाओं, पात्रता और जरूरी दस्तावेजों की सही जानकारी तक पहुँच।"},{icon:Users,title:"ग्राम सभा में संवाद",desc:"स्थानीय जरूरतों पर खुली चर्चा और प्राथमिकताओं को दर्ज करने के अवसर।"}].map((x,i)=>{const Icon=x.icon;return <article className="agenda-v2-card" key={x.title}><span className="agenda-index">0{i+1}</span><div className="agenda-v2-icon"><Icon size={24}/></div><h3>{x.title}</h3><p>{x.desc}</p></article>;})}
