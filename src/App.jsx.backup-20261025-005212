  const SupportPage = () => <main className="content-page">{PageTitle({ eyebrow: "03 / जन-सहभागिता", title: "जन समर्थन", description: "अपना संदेश दर्ज करें। कृपया आधार, बैंक विवरण या अन्य संवेदनशील निजी जानकारी साझा न करें।" })}<div className="support-layout"><aside className="support-aside"><div className="big-icon"><MessageSquareText size={28}/></div><h2>जन समर्थन संदेश दर्ज करें।</h2><p>आपका संदेश समीक्षा के लिए जमा होगा। स्वीकृति के बाद ही सार्वजनिक संदेश बोर्ड पर दिखेगा।</p><div className="mini-rule"><ShieldCheck size={18}/><span>सुरक्षित समीक्षा<br/><small>सभी संदेश तुरंत सार्वजनिक नहीं होते।</small></span></div></aside><form className="support-form-v2" onSubmit={submitMessage}><div className="form-heading"><strong>जन समर्थन फॉर्म</strong><span>* आवश्यक</span></div><label>नाम <small>(वैकल्पिक)</small><input maxLength="60" value={form.display_name} onChange={e=>setForm({...form,display_name:e.target.value})} placeholder="अपना नाम"/></label><label>संदेश का प्रकार<select value={form.category} onChange={e=>setForm({...form,category:e.target.value})}>{categories.map(c=><option key={c}>{c}</option>)}</select></label><label>आपका संदेश *<textarea required minLength="4" maxLength="500" rows="5" value={form.message} onChange={e=>setForm({...form,message:e.target.value})} placeholder="अपना समर्थन संदेश या अपनी बात लिखें…"/></label><label>तस्वीर जोड़ें <small>(वैकल्पिक · अधिकतम 2 MB)</small><input type="file" accept="image/jpeg,image/png,image/webp" onChange={e=>{const f=e.target.files?.[0]||null;if(!f){setSuggestionPhoto(null);setSuggestionPhotoPreview("");return;}const ok=["image/jpeg","image/png","image/webp"].includes(f.type)&&f.size<=2*1024*1024;if(!ok){e.target.value="";setSuggestionPhoto(null);setSuggestionPhotoPreview("");setStatus("कृपया 2 MB से छोटी JPG, PNG या WebP तस्वीर चुनें।");return;}setStatus("");setSuggestionPhoto(f);setSuggestionPhotoPreview(URL.createObjectURL(f));}} /></label>{suggestionPhotoPreview&&<div className="suggestion-photo-preview"><img src={suggestionPhotoPreview} alt="आपकी चुनी हुई तस्वीर का पूर्वावलोकन"/><button type="button" onClick={()=>{setSuggestionPhoto(null);setSuggestionPhotoPreview("");}}>तस्वीर हटाएँ</button></div>}<div className="char-count">{form.message.length}/500 अक्षर</div><button className="btn btn-primary submit-btn" disabled={busy}>{busy?"जमा हो रहा है…":"समर्थन संदेश जमा करें"} <Send size={16}/></button>{status&&<p className="form-status" role="status">{status}</p>}{!supabaseReady&&<p className="form-help">ऑनलाइन फॉर्म चालू करने के लिए Supabase सेटअप आवश्यक है।</p>}<p className="fine-print">संदेश की समीक्षा की जा सकती है। स्वीकृत संदेश सार्वजनिक रूप से दिख सकते हैं।</p></form></div></main>;

  const MessagesPage = () => <main className="content-page">{PageTitle({ eyebrow: "04 / सार्वजनिक संवाद", title: "स्वीकृत सार्वजनिक संदेश", description: "जन समर्थन, शुभकामनाएँ और स्थानीय संदेश समीक्षा और स्वीकृति के बाद यहाँ प्रदर्शित होंगे।" })}{!supabaseReady?<div className="empty-v2"><MessageCircle size={30}/><h3>संदेश बोर्ड सेटअप बाकी है</h3><p>Supabase URL और public anon key जोड़कर schema लागू करने के बाद स्वीकृत संदेश यहाँ दिखेंगे।</p></div>:messagesLoading?<div className="empty-v2" role="status">संदेश लोड हो रहे हैं…</div>:messagesError?<div className="empty-v2" role="alert"><MessageCircle size={30}/><h3>संदेश लोड नहीं हो सके</h3><p>{messagesError}</p><button className="btn btn-outline" type="button" onClick={loadMessages}>फिर कोशिश करें</button></div>:messages.length===0?<div className="empty-v2"><MessageCircle size={30}/><h3>अभी कोई स्वीकृत संदेश नहीं</h3><p>संदेश समीक्षा के बाद मंजूर होंगे, तभी यहाँ दिखाई देंगे।</p><button className="btn btn-outline" type="button" onClick={loadMessages}>रीफ्रेश करें</button></div>:<><div className="messages-toolbar"><span>{messages.length} हाल के स्वीकृत संदेश</span><button className="btn btn-outline" type="button" onClick={loadMessages} disabled={messagesLoading}>रीफ्रेश करें</button></div><div className="public-message-grid">{messages.map(m=><article className="public-message" key={m.id}><span><CheckCircle2 size={14}/>{m.category}</span><p>{m.message}</p>{m.photo_url&&<img className="public-message-photo" src={m.photo_url} alt="सुझाव के साथ भेजी गई तस्वीर" loading="lazy" decoding="async"/>}<small>{m.display_name||"गाँव के एक सदस्य"} · {new Date(m.created_at).toLocaleDateString("hi-IN")}</small></article>)}</div></>}</main>;

  const RuralMessagePage = () => <main className="content-page">{PageTitle({ eyebrow: "05 / ग्रामीण नागरिकों के नाम", title: "ग्रामीणों के लिए संदेश", description: "श्री रामस्वरूप बरोड़ जी की ओर से गाँव के सभी नागरिकों के लिए सम्मान, संवाद और जन-भागीदारी पर संदेश।" })}<section className="rural-message-shell"><div className="rural-message-top"><img src="/ramswaroop-portrait.jpg" alt="रामस्वरूप बरोड़"/><div><span className="eyebrow">सादर संदेश</span><h2>श्री रामस्वरूप बरोड़</h2><p>कीकर वाली जोहड़ी · तहसील सूरतगढ़</p></div></div><div className="rural-message-copy"><p className="message-greeting">मेरे गाँव के सभी ग्रामीण मतदाताओं, माताओं-बहनों, बुजुर्गों, युवाओं और किसान भाइयों को मेरा नमस्कार।</p><p>गाँव की वास्तविक जरूरतों को समझने के लिए हर परिवार की बात सुनना और लोगों के अनुभवों को सम्मान देना जरूरी है। पेयजल, रास्ते, साफ-सफाई, रोशनी, शिक्षा, स्वास्थ्य और सरकारी योजनाओं की सही जानकारी जैसे विषय गाँव के दैनिक जीवन से जुड़े हैं। इन मुद्दों पर आपकी राय, सुझाव और स्थानीय अनुभव महत्वपूर्ण हैं।</p><p>मेरी इच्छा है कि गाँव से जुड़े विषयों पर बातचीत आपसी सम्मान, भाईचारे और पारदर्शिता के साथ हो। किसी समस्या या सुझाव को साझा करते समय उसका स्थान, समस्या कब से है और उससे किन लोगों को परेशानी होती है—जैसी जानकारी देने से विषय को बेहतर ढंग से समझने में मदद मिलती है।</p><p>ग्राम सभा, स्थानीय निकायों और संबंधित सरकारी विभागों की प्रक्रियाओं को समझना तथा किसी भी जानकारी की पुष्टि करना भी जरूरी है। कोई भी मुद्दा हो, उसे शांतिपूर्ण और जिम्मेदार संवाद के माध्यम से सामने रखना हम सबकी साझा जिम्मेदारी है।</p><p>लोकतंत्र में हर नागरिक की भागीदारी और स्वतंत्र निर्णय का सम्मान होना चाहिए। कृपया उपलब्ध जानकारी को समझकर, अपने विवेक से और बिना किसी दबाव के अपना निर्णय लें। इस मंच के माध्यम से मैं गाँव के मुद्दों पर सुझाव सुनने और संवाद बनाए रखने का प्रयास करूँगा।</p><p className="message-signoff">सादर,<br/><strong>श्री रामस्वरूप बरोड़</strong><br/><span>कीकर वाली जोहड़ी, तहसील सूरतगढ़</span></p></div><div className="rural-message-actions"><button className="btn btn-primary" onClick={() => navigate("support")}>अपना सुझाव साझा करें <ArrowUpRight size={16}/></button><button className="btn btn-outline" onClick={() => navigate("contact")}>संपर्क विकल्प देखें <PhoneCall size={16}/></button></div></section><div className="notice-box"><ShieldCheck/><p>यह संदेश जन-संवाद और नागरिक भागीदारी पर केंद्रित है। स्थानीय स्थिति, संपर्क विवरण और प्रकाशित संदेशों की अंतिम पुष्टि उम्मीदवार/वेबसाइट प्रकाशक द्वारा की जानी चाहिए।</p></div></main>;

  const GalleryPage = () => <main className="content-page gallery-page">
    {PageTitle({ eyebrow: "06 / फोटो गैलरी", title: "ग्रामीणों के साथ तस्वीरें", description: "कीकर वाली जोहड़ी में ग्रामीण परिवेश और लोगों के साथ हुई मुलाकातों की तस्वीरें। तस्वीरों को मूल दृश्य के अनुरूप रखा गया है।" })}
    <div className="gallery-note"><ShieldCheck size={18}/><p>तस्वीरें वेबसाइट पर उपलब्ध कराने से पहले इनमें दिखाई दे रहे लोगों की निजता और प्रकाशन की अनुमति का ध्यान रखें। तस्वीरें किसी व्यक्ति के समर्थन या किसी विशेष घटना का प्रमाण अपने-आप नहीं मानी जानी चाहिए।</p></div>
    <div className="community-gallery-grid">{communityPhotos.map((photo, index) => <button className="community-photo-card" key={photo.src} onClick={() => setSelectedPhoto(photo)} aria-label={`${photo.caption}, बड़ी तस्वीर देखें`}><div className="community-photo-frame"><img src={photo.src} alt={photo.alt} loading="lazy" decoding="async"/><span className="photo-zoom"><ArrowUpRight size={18}/></span></div><span className="community-photo-caption"><strong>{photo.caption}</strong><small>फोटो {String(index+1).padStart(2,"0")} · कीकर वाली जोहड़ी</small></span></button>)}</div>
    {selectedPhoto && <div className="photo-lightbox" role="dialog" aria-modal="true" aria-label="बड़ी तस्वीर" onClick={() => setSelectedPhoto(null)}><button className="photo-lightbox-close" onClick={(event) => { event.stopPropagation(); setSelectedPhoto(null); }} aria-label="तस्वीर बंद करें"><X size={22}/></button><img src={selectedPhoto.src} alt={selectedPhoto.alt} onClick={event => event.stopPropagation()}/><p>{selectedPhoto.caption}</p></div>}
  </main>;

  const ContactPage = () => <main className="content-page">{PageTitle({ eyebrow: "06 / संपर्क", title: "संपर्क में रहें", description: "नीचे दिए गए सार्वजनिक संपर्क विकल्पों का उपयोग करें।" })}<div className="contact-v2-grid"><a className="contact-v2-card" href={`tel:${CONTACT_PHONE}`}><span className="contact-v2-icon"><PhoneCall/></span><div><small>सीधे कॉल करें</small><h3>श्री रामस्वरूप बरोड़</h3><p>75681 18606</p></div><ArrowUpRight/></a><a className="contact-v2-card" href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noreferrer"><span className="contact-v2-icon whatsapp"><MessageCircle/></span><div><small>टीम WhatsApp</small><h3>श्री जयपाल बरोड़</h3><p>+91 87697 23698</p></div><ArrowUpRight/></a><div className="contact-v2-card address-card"><span className="contact-v2-icon"><MapPin/></span><div><small>संपर्क स्थान</small><h3>आवास स्थल</h3><p>कीकर वाली जोहड़ी, तहसील सूरतगढ़</p></div></div></div><button className="btn btn-primary" onClick={shareSite}><Share2 size={17}/> वेबसाइट शेयर करें</button>{shareStatus&&<p className="form-status">{shareStatus}</p>}</main>;

  const FaqPage = () => <main className="content-page">{PageTitle({ eyebrow: "07 / मदद", title: "अक्सर पूछे जाने वाले सवाल", description: "वेबसाइट, स्थानीय मुद्दों और जन-संवाद से जुड़ी जानकारी।" })}<div className="faq-v2-list">{[["इस वेबसाइट का उद्देश्य क्या है?","सार्वजनिक परिचय, स्थानीय प्राथमिकताओं और संपर्क विकल्पों की जानकारी देना।"],["गाँव की समस्या कैसे भेजें?","जन-संवाद पेज पर फॉर्म भरकर संदेश जमा करें।"],["क्या हर संदेश सार्वजनिक होगा?","नहीं। केवल समीक्षा के बाद स्वीकृत संदेश प्रदर्शित होंगे।"],["क्या विकास कार्य पूरे हो चुके हैं?","यहाँ दिए विषय संभावित प्राथमिकताएँ हैं; इन्हें पूर्ण हो चुके काम के रूप में नहीं दर्शाया गया है।"],["संपर्क कैसे करें?","संपर्क पेज पर कॉल और WhatsApp बटन उपलब्ध हैं।"],["तस्वीरें कहाँ देख सकते हैं?","होम पेज के तस्वीरों वाले हिस्से से फोटो गैलरी खोलें।"]].map(([q,a])=><details key={q}><summary>{q}</summary><p>{a}</p></details>)}</div></main>;

  const renderPage = () => {
    switch(page) {
      case "about": return AboutPage();
      case "agenda": return AgendaPage();
      case "support": return SupportPage();
      case "messages": return MessagesPage();
      case "gallery": return GalleryPage();
      case "contact": return ContactPage();
      case "faq": return FaqPage();
      default: return HomePage();
    }
  };

  return <div className="site-shell">
    <div className="top-ribbon"><span><MapPin size={13}/> कीकर वाली जोहड़ी, सूरतगढ़</span><span>सार्वजनिक जानकारी · जन-संवाद</span></div>
    {Header()}
    {renderPage()}
    <footer className="site-footer"><div className="footer-main"><button className="footer-brand" onClick={()=>navigate("home")}><img src="/ramswaroop-portrait.jpg" alt=""/><span><strong>श्री रामस्वरूप बरोड़</strong><small>कीकर वाली जोहड़ी · सूरतगढ़</small></span></button><p>स्थानीय मुद्दों, सार्वजनिक जानकारी और जन-सहभागिता के लिए बनाया गया मंच।<br/><span className="developer-credit">वेबसाइट डिज़ाइन एवं विकास: जितेंद्र सोनी</span></p><div className="footer-actions"><button onClick={()=>navigate("contact")}>संपर्क <ArrowUpRight size={14}/></button><button onClick={shareSite}>शेयर <Share2 size={14}/></button></div></div><div className="footer-bottom"><span>प्रकाशित जानकारी की सत्यता की पुष्टि प्रकाशक द्वारा की जानी चाहिए।</span><button onClick={()=>navigate("faq")}>FAQ</button></div></footer>
    <div className="mobile-bottom-nav"><button className={page==="home"?"selected":""} onClick={()=>navigate("home")}><Home size={19}/><span>होम</span></button><button className={page==="agenda"?"selected":""} onClick={()=>navigate("agenda")}><ClipboardList size={19}/><span>प्राथमिकताएँ</span></button><button className={page==="support"?"selected":""} onClick={()=>navigate("support")}><MessageCircle size={19}/><span>सुझाव</span></button><button className={page==="contact"?"selected":""} onClick={()=>navigate("contact")}><Phone size={19}/><span>संपर्क</span></button></div>
  </div>;
}

export default App;
